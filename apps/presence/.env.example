# Discord bot token.
DISCORD_TOKEN=

# Server shared by the bot and the tracked users.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs to expose. Nobody else is ever served.
TRACKED_USER_IDS=

# Browser origins allowed to use the API, comma-separated, or * for any.
ALLOWED_ORIGINS=https://rustbuilderz.xyz,http://localhost:4321

# Optional.
# HOST=0.0.0.0
# PORT=4100
# HEARTBEAT_INTERVAL_MS=30000
# MAX_CONNECTIONS=1000
# LOG_LEVEL=info
