{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rustbuilderz-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths reach the Worker: Matrix traffic for the homeserver,
    // and the small API (visitor counter, live GitHub data).
    "run_worker_first": ["/_matrix/*", "/_continuwuity/*", "/.well-known/matrix/*", "/api/*"],
  },
  // The visitor counter's database. Wrangler created it on the first deploy;
  // the ID is pinned so every later deploy uses the same one.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rustbuilderz-web-db",
      "database_id": "94babbe3-a79d-436a-a245-0fdcaa0641db",
    },
  ],
  // A route, not a custom domain: the apex keeps its existing DNS record and
  // origin, and the Worker sits in front of it.
  "routes": [{ "pattern": "rustbuilderz.xyz/*", "zone_name": "rustbuilderz.xyz" }],
  "workers_dev": false,
  "observability": { "enabled": true },
}
