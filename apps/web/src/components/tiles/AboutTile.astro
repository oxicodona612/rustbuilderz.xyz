---
import { site } from '../../site.config';
import Icon from '../Icon.astro';
import Tile from '../Tile.astro';

const { about, stack, homeserver } = site;
---

<Tile label="About" span={8} id="about">
  <div class="terminal">
    <div class="block">
      <p class="command">
        <span aria-hidden="true">$</span> whoami
      </p>
      {about.map((paragraph) => (
        <p class="output">{paragraph}</p>
      ))}
    </div>

    <div class="block">
      <p class="command">
        <span aria-hidden="true">$</span> cat stack.txt
      </p>
      <ul class="stack" aria-label="Tools I use">
        {stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <p class="command">
        <span aria-hidden="true">$</span> curl {homeserver.name}/_matrix/federation/v1/version
      </p>
      <p class="output homeserver" data-homeserver={homeserver.baseUrl} aria-live="polite">
        <Icon name="server" size={16} />
        <span data-homeserver-text>checking homeserver…</span>
      </p>
    </div>
  </div>
</Tile>

<script>
  const target = document.querySelector<HTMLElement>('[data-homeserver]');
  const text = target?.querySelector<HTMLElement>('[data-homeserver-text]');

  interface VersionResponse {
    server?: { name?: string; version?: string };
  }

  if (target && text) {
    const started = performance.now();
    fetch(`${target.dataset.homeserver}/_matrix/federation/v1/version`, {
      cache: 'no-store',
      signal: AbortSignal.timeout(6000),
    })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json() as Promise<VersionResponse>;
      })
      .then(({ server }) => {
        const latency = Math.round(performance.now() - started);
        const version = server?.version?.split(' ')[0];
        target.dataset.state = 'up';
        text.textContent = `${server?.name ?? 'homeserver'} ${version ?? ''} · online · ${latency} ms`;
      })
      .catch(() => {
        target.dataset.state = 'down';
        text.textContent = 'homeserver unreachable';
      });
  }
</script>

<style>
  .terminal {
    display: grid;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .block {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .terminal p {
    margin: 0;
  }

  .command {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .block .command:not(:first-child) {
    margin-top: 0.5rem;
  }

  .command span {
    color: var(--accent);
  }

  .output {
    color: var(--text-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.1rem 0.55rem;
    border: 1px solid rgb(var(--accent-rgb) / 0.25);
    border-radius: 6px;
    background: rgb(var(--accent-rgb) / 0.06);
    color: var(--accent-soft);
    font-size: 0.75rem;
  }

  .homeserver {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .homeserver[data-state='up'] {
    color: var(--status-online);
  }

  .homeserver[data-state='down'] {
    color: var(--status-dnd);
  }
</style>
