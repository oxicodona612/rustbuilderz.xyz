---
import { site } from '../../site.config';

const { presence, github, taglines } = site;
const live = presence.discordUserId.length > 0;
---

<section class="tile span-8 profile" aria-labelledby="profile-name" data-spotlight>
  <div class="banner" aria-hidden="true">
    <img class="banner-image" data-slot="banner" alt="" hidden />
  </div>

  <div class="identity">
    <div class="avatar">
      <img
        class="avatar-image"
        data-slot="avatar"
        src={github.avatar}
        alt={`${site.name}'s avatar`}
        width="112"
        height="112"
        fetchpriority="high"
      />
      <img class="avatar-decoration" data-slot="decoration" alt="" hidden />
      {live && <span class="avatar-status" aria-hidden="true" />}
    </div>

    <div class="names">
      <div class="name-row">
        <h1 class="name" id="profile-name">
          {site.name}
        </h1>
        <span class="tag" data-slot="tag" hidden>
          <img data-slot="tag-badge" width="14" height="14" alt="" hidden />
          <span data-slot="tag-text"></span>
        </span>
        <span class="badges" data-slot="badges" hidden></span>
      </div>
      <p class="handle" data-slot="handle" hidden></p>
    </div>
  </div>

  <p class="tagline" data-typer={JSON.stringify(taglines)}>
    <span class="prompt" aria-hidden="true">
      ~$
    </span>
    <span data-typer-text>{taglines[0]}</span>
    <span class="caret" aria-hidden="true"></span>
  </p>

  {live && (
    <div class="meta">
      <p class="status" aria-live="polite">
        <span class="status-dot" aria-hidden="true" />
        <span data-slot="status-text">Connecting to Discord</span>
      </p>
      <p class="since" data-slot="since" hidden />
    </div>
  )}

  {live && (
    <p class="custom-status" data-slot="custom-status" hidden>
      <img data-slot="custom-emoji" width="20" height="20" alt="" hidden />
      <span data-slot="custom-text" />
    </p>
  )}
</section>

<style>
  .profile {
    gap: 0.9rem;
    padding: 0 0 1.4rem;
  }

  .profile > :not(.banner) {
    margin-inline: 1.4rem;
  }

  .banner {
    position: relative;
    height: 132px;
    margin: 0;
    /* The profile color when there is one, otherwise a faint wash of the accent. */
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(var(--accent-rgb) / 0.22), transparent 60%),
      linear-gradient(135deg, var(--banner-color, #141416), #070708);
    overflow: hidden;
  }

  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.12) 1px, transparent 1px);
    background-size: 14px 14px;
    mask-image: linear-gradient(to bottom, #000, transparent);
  }

  .banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .identity {
    display: flex;
    align-items: flex-end;
    gap: 1.1rem;
    margin-top: -56px;
    position: relative;
    z-index: 2;
  }

  .avatar {
    position: relative;
    flex: none;
    width: 112px;
    height: 112px;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-solid);
    box-shadow: 0 0 0 6px var(--surface);
  }

  .avatar-decoration {
    position: absolute;
    inset: -12%;
    width: 124%;
    height: 124%;
    pointer-events: none;
  }

  .avatar-status {
    position: absolute;
    right: 6px;
    bottom: 6px;
    width: 24px;
    height: 24px;
    border: 5px solid var(--surface);
    border-radius: 50%;
    background: var(--status-color, var(--status-unknown));
    transition: background-color 300ms ease;
  }

  :global([data-status='online']) {
    --status-color: var(--status-online);
  }
  :global([data-status='idle']) {
    --status-color: var(--status-idle);
  }
  :global([data-status='dnd']) {
    --status-color: var(--status-dnd);
  }
  :global([data-status='offline']) {
    --status-color: var(--status-offline);
  }

  .names {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
    padding-bottom: 0.35rem;
  }

  .name-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
  }

  .name {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-raised);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .tag[hidden],
  .badges[hidden] {
    display: none;
  }

  .badges {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.2rem 0.35rem;
    border-radius: 8px;
    background: var(--surface-raised);
  }

  .handle {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .tagline {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    min-height: 1.5em;
    margin-block: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .prompt {
    color: var(--accent);
  }

  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    margin-left: 1px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .meta p {
    margin: 0;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-color, var(--status-unknown));
  }

  .since[hidden] {
    display: none;
  }

  .custom-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    max-width: calc(100% - 2.8rem);
    margin-block: 0;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px 999px 999px 6px;
    background: var(--surface-raised);
    font-size: 0.875rem;
  }

  .custom-status[hidden] {
    display: none;
  }

  @media (max-width: 520px) {
    .identity {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
