---
import { siDiscord, siGithub, siMatrix, siSpotify, siTiktok } from 'simple-icons';

/** Brand marks come from Simple Icons and are filled. Interface icons are stroked. */
const brands = {
  github: siGithub.path,
  discord: siDiscord.path,
  matrix: siMatrix.path,
  tiktok: siTiktok.path,
  spotify: siSpotify.path,
};

const strokes = {
  copy: 'M9 9h10v10H9zM5 15V5h10',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  external: 'M14 5h5v5M19 5l-8 8M18 14v5H5V6h5',
  star: 'M12 4l2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8z',
  gamepad:
    'M6 9h12a3 3 0 0 1 3 3v2a3 3 0 0 1-5.1 2.1L14.5 15h-5l-1.4 1.1A3 3 0 0 1 3 14v-2a3 3 0 0 1 3-3zM8 11v3M6.5 12.5h3M15.5 12h0M17.5 13.5h0',
  arrow: 'M7 17L17 7M9 7h8v8',
  server: 'M4 5h16v6H4zM4 13h16v6H4zM8 8h0M8 16h0',
  terminal: 'M5 7l5 5-5 5M12 17h7',
};

export type IconName = keyof typeof brands | keyof typeof strokes;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const brand = name in brands ? brands[name as keyof typeof brands] : null;
---

{brand ? (
  <svg
    class:list={['icon', className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={brand} />
  </svg>
) : (
  <svg
    class:list={['icon', className]}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={strokes[name as keyof typeof strokes]} />
  </svg>
)}
