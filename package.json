{
  "name": "rustbuilderz.xyz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rustbuilderz/web dev",
    "dev:presence": "pnpm --filter @rustbuilderz/presence dev",
